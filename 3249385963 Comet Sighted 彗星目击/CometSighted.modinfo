<?xml version="1.0" encoding="utf-8"?>
<Mod id="eff1a233-a581-4acc-a1c1-214545e51b63" version="1">
  <Properties>
    <Name>Comet Sighted</Name>
    <Description>Each time a meteor shower happens launches the 'comet sighted' event</Description>
    <Created>1716060824</Created>
    <Teaser>A mod to add the the Paradox-fan-favourite 'comet sighted' event to CivVI!</Teaser>
    <Authors>SpatialX</Authors>
    <CompatibleVersions>1.2,2.0</CompatibleVersions>
  </Properties>
  <Dependencies>
    <Mod id="9DE86512-DE1A-400D-8C0A-AB46EBBF76B9" title="DLC: Grand Colombia Maya Civilization Pack" />
    <Mod id="44f934a2-ca06-4b95-898b-dcb9d61c4173" title="Events Popup Framework" />
  </Dependencies>
  <FrontEndActions>
    <UpdateIcons id="Icons">
      <File>Database/Comet_Events_Icons.xml</File>
    </UpdateIcons>
    <UpdateArt id="Art">
      <File>CometSighted.dep</File>
    </UpdateArt>
  </FrontEndActions>
  <InGameActions>
    <UpdateArt id="Art">
      <File>CometSighted.dep</File>
    </UpdateArt>
    <UpdateDatabase id="Gameplay">
      <File>Database/Comet_EventsList.sql</File>
      <File>Database/CometEffects.xml</File>
    </UpdateDatabase>
    <UpdateIcons id="Icons">
      <File>Database/Comet_Events_Icons.xml</File>
    </UpdateIcons>
    <UpdateText id="Text">
      <File>Database/Comet_Events_Text.xml</File>
    </UpdateText>
    <AddGameplayScripts id="Event">
      <Properties>
        <LoadOrder>30000</LoadOrder>
      </Properties>
      <File>Scripts/Comet_EventsDefinitions.lua</File>
    </AddGameplayScripts>
  </InGameActions>
  <Files>
    <File>ArtDefs/Units.artdef</File>
    <File>CometSighted.dep</File>
    <File>Database/CometEffects.xml</File>
    <File>Database/Comet_EventsList.sql</File>
    <File>Database/Comet_Events_Icons.xml</File>
    <File>Database/Comet_Events_Text.xml</File>
    <File>Platforms/MacOS/BLPs/UI/Icons.blp</File>
    <File>Platforms/Windows/BLPs/UI/Icons.blp</File>
    <File>Scripts/Comet_EventsDefinitions.lua</File>
    <File>texture/CometSighted.dds</File>
  </Files>
</Mod>